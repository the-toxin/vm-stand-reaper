{
  "permissions": {
    "allow": [
      "Bash(poetry install:*)",
      "Bash(poetry run:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/bash-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command // empty'); TS=$(date -u +%Y-%m-%dT%H:%M:%SZ); LOG=\"${CLAUDE_PROJECT_DIR:-.}/.claude/bash-audit.log\"; printf '%s  %s\\n' \"$TS\" \"$CMD\" >> \"$LOG\"; exit 0"
          }
        ]
      }
    ]
  }
}
